# The update, as root: it installs the version asked for, switches to it and
# keeps it only once it says it works. The trusted version's program does
# this, never the one being installed.
[Unit]
Description=FernSDR update

[Service]
Type=oneshot
ExecStart=/opt/fernsdr/trusted/fernsdr --update-run
# A download on a slow line, the check, the restart and a trial of at most
# fifteen minutes.
TimeoutStartSec=40min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/fernsdr /var/lib/fernsdr /var/lib/fernsdr-update
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=ENOSYS
# Root, but only for what updating takes: reading and writing the receiver's
# directory, handing restored files back to its user, becoming that user for
# the new version's check and stopping the check if it hangs.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL
UMask=0022
