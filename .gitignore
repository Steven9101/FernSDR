# server/fernsdr.example.conf is the tracked template.
server/fernsdr.conf
server/*.ini
server/*.ini.orig
Caddyfile
__pycache__/

# Waterfall archives: a day of one band is about 90 MB.
*.wfa

# Playwright scratch output.
.playwright-mcp/

# Benchmark captures are retained locally; publish checksums and raw events.
bench/captures/
bench/runs/**/*.f32
bench/runs/**/*.wav
bench/runs/**/*.flac

# Per-receiver runtime state written by the admin panel.
fernsdr-settings.json
fernsdr-theme.json

# Pictures an operator uploaded through the admin panel.
fernsdr-uploads/

# Generated reference audio (bench/digital/digital.py assets regenerates it).
bench/digital/assets/
# Working notes of the benchmark sessions, not part of the method.
bench/planning/

# The release page build.
site/dist/
