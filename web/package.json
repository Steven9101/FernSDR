{
  "name": "fernsdr-sdr-web",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Client for the FernSDR receiver",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vite build && vite build --mode admin && node tools/compress.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "svelte": "^5.57.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
